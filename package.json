{
  "name": "digitalkingz",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "predev": "node scripts/preflight.mjs --mode=dev",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "devsafe": "rimraf .next && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "prebuild": "node scripts/preflight.mjs --mode=build",
    "build": "cross-env NODE_OPTIONS=--no-deprecation DK_BUILD_PHASE=1 payload generate:importmap && cross-env NODE_OPTIONS=--no-deprecation DK_BUILD_PHASE=1 next build",
    "prestart": "node scripts/preflight.mjs --mode=start",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "start:migrate": "pnpm db:migrate && pnpm start",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation next lint",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck && pnpm lint && pnpm content:check",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d",
    "db:logs": "docker compose logs -f postgres",
    "predb:migrate": "node scripts/preflight.mjs --mode=migrate",
    "db:migrate": "cross-env NODE_OPTIONS=--no-deprecation payload migrate",
    "predb:migrate:create": "node scripts/preflight.mjs --mode=migrate",
    "db:migrate:create": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:create",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "preseed": "node scripts/preflight.mjs --mode=seed",
    "seed": "cross-env NODE_OPTIONS=--no-deprecation tsx src/seed/run.ts",
    "content:check": "cross-env NODE_OPTIONS=--no-deprecation tsx src/seed/validate.ts"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.87.1",
    "@payloadcms/next": "3.87.1",
    "@payloadcms/richtext-lexical": "3.87.1",
    "@payloadcms/ui": "3.87.1",
    "clsx": "^2.1.1",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "geist": "^1.7.2",
    "graphql": "^16.11.0",
    "lucide-react": "^0.554.0",
    "next": "15.4.11",
    "payload": "3.87.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "resend": "^6.1.2",
    "server-only": "^0.0.1",
    "sharp": "0.34.2",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^22.18.1",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "eslint": "^9.35.0",
    "eslint-config-next": "15.4.11",
    "rimraf": "^6.0.1",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.20.5",
    "typescript": "5.7.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "@tailwindcss/oxide",
      "unrs-resolver"
    ]
  }
}
