# ---------------------------------------------------------------------------
# Digital Kingz — environment variables
#
# LOCAL:      run `pnpm setup` and this file is copied to .env for you with a
#             generated secret and the Docker database already wired up.
# PRODUCTION: set these in Coolify → Application → Environment Variables.
#             No .env file is needed, or wanted, in production. The build does
#             not read one and does not require one.
#
# BUILD vs RUNTIME. In Coolify, tick "Build Variable" for NEXT_PUBLIC_SERVER_URL
# only. It is compiled into the output and is public anyway. Every secret below
# is read at runtime; marking one as a build variable writes it into the Docker
# image history and is what triggers the SecretsUsedInArgOrEnv warning.
#
# Never commit .env. It is git-ignored.
# ---------------------------------------------------------------------------

# --- Required -------------------------------------------------------------

# PostgreSQL connection string.
#   Local (Docker, via `pnpm db:up`): the value below works as-is.
#   Production: the INTERNAL hostname of your Coolify Postgres resource,
#   e.g. postgres://user:pass@digitalkingz-db:5432/digitalkingz
DATABASE_URI=postgres://digitalkingz:localdev@127.0.0.1:5433/digitalkingz

# Random 32+ character string used to sign Payload auth tokens.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Use a DIFFERENT value locally and in production.
PAYLOAD_SECRET=change-me-to-a-long-random-string

# Canonical origin, NO TRAILING SLASH. Drives canonicals, sitemap, Open Graph
# URLs and JSON-LD @id values.
#   Local:      http://localhost:3000
#   Production: https://digitalkingz.com
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# --- Lead routing (Resend) ------------------------------------------------
# Without these the form still works and still saves every enquiry to the CMS.
# It just records "Email skipped" against the lead so the gap is visible.

# From https://resend.com/api-keys
RESEND_API_KEY=

# Must be on a domain you have verified in Resend → Domains.
# Use a subdomain like send.digitalkingz.com or mail.digitalkingz.com for
# sending, so a deliverability problem can never affect your main domain's
# reputation for normal business email.
LEAD_EMAIL_FROM=Digital Kingz <notifications@send.digitalkingz.com>

# Where new lead notifications land. Comma-separated for multiple recipients.
LEAD_EMAIL_TO=solutions@digitalkingz.com

# --- CRM / automation handoff (optional) ----------------------------------

# Every submitted lead is POSTed here as JSON. Works with n8n, Make, Zapier,
# HubSpot, Go High Level, Pipedrive.
CRM_WEBHOOK_URL=

# Optional shared secret, sent as the X-Webhook-Secret header. Verify it on
# the receiving end.
CRM_WEBHOOK_SECRET=

# --- Optional -------------------------------------------------------------

# Google Search Console verification token (meta tag method).
GOOGLE_SITE_VERIFICATION=

# Set to "true" to expose the GraphQL playground in production.
ENABLE_GRAPHQL_PLAYGROUND=false

# Schema mechanism. LOCAL ONLY — do not set this in Coolify.
#
# "false" makes local development use the committed migrations in
# src/migrations, exactly as production does. Keep it that way.
#
# Payload's alternative is "push", which silently syncs schema changes straight
# into your local database. That sounds convenient and is a trap: once push has
# already applied a change, `pnpm db:migrate:create` sees no difference between
# your schema and your database, generates an empty migration, and the change
# never reaches production.
#
# After changing a collection:
#   pnpm db:migrate:create describe_the_change
#   pnpm db:migrate
PAYLOAD_DB_PUSH=false

# --- Seeded admin account -------------------------------------------------
# Used once by `pnpm seed` to create the first admin user. Both must have a
# value: a key with nothing after the "=" counts as unset and the seed will
# stop with an explanation.
#
# The password below is published in this file and is therefore PUBLIC. It is
# fine for a throwaway local database. Set a unique one in Coolify before
# seeding production - the seed refuses to use this value there.
SEED_ADMIN_EMAIL=solutions@digitalkingz.com
SEED_ADMIN_PASSWORD=ChangeMe-DigitalKingz-2026

# Google Tag Manager. The live container id is the default in code, so GTM
# works with no configuration. Set this only to point a staging build at a
# different container — and set it as a BUILD variable in Coolify if you do,
# because NEXT_PUBLIC_* values are compiled in.
# NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX
