# ---------------------------------------------------------------------------
# Digital Kingz — environment variables
# Set these in Coolify → Application → Environment Variables.
# Never commit a real .env file.
# ---------------------------------------------------------------------------

# --- Required -------------------------------------------------------------

# PostgreSQL connection string.
# In Coolify, point this at the internal service hostname of your Postgres
# resource, e.g. postgres://user:pass@digitalkingz-db:5432/digitalkingz
DATABASE_URI=postgres://postgres:devpassword@127.0.0.1:5432/digitalkingz

# Random 32+ character string used to sign Payload auth tokens.
# Generate with: openssl rand -base64 32
PAYLOAD_SECRET=change-me-to-a-long-random-string

# Public canonical origin, no trailing slash. Used for canonicals, sitemap,
# Open Graph URLs and JSON-LD @id values.
NEXT_PUBLIC_SERVER_URL=https://digitalkingz.com

# --- Lead routing (optional but strongly recommended) ---------------------

# Resend API key. Without it the form still saves leads to the CMS,
# it just will not send the notification email.
RESEND_API_KEY=

# Verified sending identity on your Resend domain.
LEAD_EMAIL_FROM=Digital Kingz <notifications@digitalkingz.com>

# Where new lead notifications are delivered. Comma-separated for multiple.
LEAD_EMAIL_TO=sales@digitalkingz.com

# Generic CRM / automation webhook. Every submitted lead is POSTed here as
# JSON. Works with n8n, Make, Zapier, HubSpot, Go High Level, Pipedrive.
CRM_WEBHOOK_URL=

# Optional shared secret sent as the X-Webhook-Secret header.
CRM_WEBHOOK_SECRET=

# --- Optional -------------------------------------------------------------

# Google Search Console verification token (meta tag).
GOOGLE_SITE_VERIFICATION=

# Set to "true" to expose the GraphQL playground in production.
ENABLE_GRAPHQL_PLAYGROUND=false
